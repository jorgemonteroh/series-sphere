{# templates/busqueda/index.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
    crossorigin="anonymous"
/>
<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css"
/>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" /> <!-- select2 librería -->
<link rel="stylesheet" type="text/css" href="{{ asset('styles/styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/buscar.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/home.css') }}">
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Madimi+One&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3&display=swap" rel="stylesheet">
{% endblock %}

{% block title %}Busqueda{% endblock %}

{% block body %}
<!-- NAVBAR: -->
    <!-- NAVBAR: -->
    <nav class="navbar navbar-expand-lg d-flex">
      <div class="container-fluid">
        <!-- ICONO: -->
        <a class="navbar-brand" href="#">
          <img src="{{ asset('img/icons/SerieSphere.gif') }}" alt="Serie Sphere" title="SerieSphere" class="logo-pagina">
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
          id="button-collapse"
          onclick="hidePfp();"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="{{ path('home') }}">Inicio</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('perfil') }}">Perfil</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('seguimiento') }}"
                >Lista de Seguimiento</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('destacados') }}">Destacados</a>
            </li>
            <li class="nav-item">
              <a class="nav-link activo" aria-current="page" href="{{ path('busqueda') }}">Buscar</a>
            </li>
          </ul>
        </div>
        <div class="dropdown">
          <img
            class="user-pfp dropdown-toggle"
            src="{{ asset('img/monke-pfp.png') }}"
            alt="user pfp"
            id="user-pfp"
            type="button"
            data-bs-toggle="dropdown"
          />
          <ul class="dropdown-menu">
            <li>
              <a class="dropdown-item" href=""
                >Ajustes<i class="bi bi-gear-wide-connected"></i
              ></a>
            </li>
            <li>
              <a class="dropdown-item" href="{{ path('app_logout') }}"
                >Cerrar Sesión<i class="bi bi-box-arrow-left"></i
              ></a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- SECCIÓN BÚSQUEDA: -->
    <section class="contenedor-pagina">
      <p class="titulo-pagina"><i>Página de búsqueda</i></p>
      <div class="contenedor-formulario">
        <form action="{{ path('busqueda_submit') }}" method="post" class="formulario-busqueda">
          <div>        
            <select name="genero" class="select-genero select-filtro">
              <option></option>
              {% for genero in array_generos %}
                <option value="{{genero.nombre}}">{{genero.nombre}}</option>
              {% endfor %}
            </select>
          </div>  
          <div>
            <select name="streaming" class="select-streaming select-filtro">
              <option></option>
              {% for streaming in array_streamings %}
                <option value="{{streaming.nombre}}">{{streaming.nombre}}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <select name="lanzamiento" class="select-lanzamiento select-filtro">
              <option></option>
              {% for lanzamiento in array_lanzamientos %}
                <option value="{{lanzamiento}}">{{lanzamiento}}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <input type="text" id="input_nombre" name="nombre" placeholder="Nombre . . .">
          </div>
          <div>
            <div class="btn-busqueda" id="input_btn">Buscar</div>
          </div>

        </form>
        <p class="separar-busqueda"></p>
        <p class="titulo-pagina" id="titulo-pagina"><i>Búsqueda: {{ busqueda_filtros }}</i></p>
        <div class="flex-container viendo-container" style="{{ container_empty }}">
          {% for serie in array_series %}
            <div>
              <a href="{{ path('mostrar_serie_id', {'id': serie.id}) }}">
                <img
                    src="{{ asset(serie.poster_src) }}"
                    class="card-img-top"
                    alt="..."
                />
              </a>
            </div>
          {% endfor %}
        </div> <!-- resultado-busqueda -->
      </div> <!-- contenedor-formulario -->
    </section>


<!-- Pie de pagina (footer) -->
    <footer>
      <div class="footer-container">
        <div class="footer-nav">
          <ul>
            <li class="footer-decor">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="5"
                viewBox="0 0 80 6"
                fill="none"
              >
                <path
                  d="M0 3H80"
                  stroke="url(#paint0_linear_44_98)"
                  stroke-opacity="0.8"
                  stroke-width="500"
                />
                <defs>
                  <linearGradient
                    id="paint0_linear_44_98"
                    x1="41.0833"
                    y1="3.00193"
                    x2="37.9583"
                    y2="3.00193"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0.168213" stop-color="#71DF7C" />
                    <stop offset="0.858244" stop-color="white" />
                  </linearGradient>
                </defs>
              </svg>
            </li>
            <li><a href="">Sobre Nosotros</a></li>
            <li><a href="">Ayuda</a></li>
            <li><a href="">API</a></li>
            <li><a href="">Términos</a></li>
            <li><a href="">Contacto</a></li>
            <li><a href="{{ path('declaracion_accesibilidad') }}"><i class="bi bi-universal-access-circle"></i></i></a></li>
            <li><a href="{{ path('mapa_web') }}"><i class="bi bi-globe"></i></a></li>
            <li><a>━━</a></li>
            <li>
              <a href=""><i class="social bi bi-twitter-x"></i></a>
            </li>
            <li>
              <a href=""><i class="social bi bi-instagram"></i></a>
            </li>
            <li>
              <a href=""><i class="social bi bi-youtube"></i></a>
            </li>
            <li class="footer-decor">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="5"
                viewBox="0 0 80 6"
                fill="none"
              >
                <path
                  d="M0 3H80"
                  stroke="url(#paint0_linear_44_98)"
                  stroke-opacity="0.8"
                  stroke-width="500"
                />
                <defs>
                  <linearGradient
                    id="paint0_linear_44_98"
                    x1="41.0833"
                    y1="3.00193"
                    x2="37.9583"
                    y2="3.00193"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0.168213" stop-color="#71DF7C" />
                    <stop offset="0.858244" stop-color="white" />
                  </linearGradient>
                </defs>
              </svg>
            </li>
          </ul>
        </div>
      </div>
    </footer>

{% endblock %}

{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"
></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script> <!-- select2 librería -->
<script src="{{ asset('select2.js') }}"></script>
<script src="{{ asset('app.js') }}"></script>
<script>

  $(document).ready(function() {

    $('#input_btn').on('click', function() {

      var input = $('#input_nombre').val();
      //alert(input);

      if (input != "") {
        $.ajax({
          url: "livesearch",
          method: "POST",
          data: {input:input},

          success:function(data){
            $("body").html(data);
          }
        });
      } else {
        $.ajax({
          url: "livesearch",
          method: "POST",
          data: {input:"selectAll"},

          success:function(data){
            $("body").html(data);
          }
        });
      }
      
    });

  });

</script>
{% endblock %}
