{% extends 'base.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600&display=swap" rel="stylesheet"/>
<link rel="stylesheet" type="text/css" href="{{ asset('styles/styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/landing.css') }}">
</style>
{% endblock %}

{% block title %}SeriesSphere{% endblock %}

{% block body %}

    <!-- NAVBAR: -->
    <nav class="navbar navbar-expand-lg d-flex">
      <div class="container-fluid">
        <!-- ICONO: -->
        <a class="navbar-brand" href="{{ path('index_') }}">
          <img src="{{ asset('img/icons/SerieSphere.gif') }}" alt="Serie Sphere" title="SerieSphere" class="logo-pagina">
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
          id="button-collapse"
          onclick="hidePfp();"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link activo" aria-current="page" href="{{ path('index_') }}">Inicio</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('destacados_invitado') }}"
                >Destacados</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('busqueda_invitado') }}">Buscar</a>
            </li>
          </ul>
        </div>
        <a href="{{ path('app_login') }}" class="btn btn-login" id="btn-login">
          Identificarse
        </a>
      </div>
    </nav>
    <!-- SECCIÓN INICIO: -->
    <section class="contenedor-pagina">
      <!-- TITULO PÁGINA: -->
      <div class="text-center contenedor-titulo-bienvenida">
        <div class="row row-cols-12">
          <div class="col">EL MEJOR ACOMPAÑANTE PARA SEGUIR TUS SERIES.&nbsp;<a href="{{ path('app_login') }}">UNETE YA!</a></div>
        </div>
      </div>

      <!-- CARRUSEL: -->
      <div class="container">
        <div id="carouselExampleCaptions" class="carousel slide col">
          <div class="carousel-indicators">
            <button
              type="button"
              data-bs-target="#carouselExampleCaptions"
              data-bs-slide-to="0"
              class="active"
              aria-current="true"
              aria-label="Slide 1"
            ></button>
            <button
              type="button"
              data-bs-target="#carouselExampleCaptions"
              data-bs-slide-to="1"
              aria-label="Slide 2"
            ></button>
            <button
              type="button"
              data-bs-target="#carouselExampleCaptions"
              data-bs-slide-to="2"
              aria-label="Slide 3"
            ></button>
            <button
              type="button"
              data-bs-target="#carouselExampleCaptions"
              data-bs-slide-to="3"
              aria-label="Slide 4"
            ></button>
          </div>
          <div class="carousel-inner">
            <div class="carousel-item active">
              <img
                src="{{ asset('img/bg_slide/SLIDE_01.jpg')}}"
                class="d-block w-100 img-carousel"
                alt="imagen-fondo-carousel"
              />
              <div class="carousel-caption d-none d-md-block">
                <h5>Mantén un seguimiento de tus series!</h5>
                <p>
                  Recuerda el capítulo en el que te quedaste, aquellas series que has visto o todas las que quieras ver.
                </p>
              </div>
            </div>
            <div class="carousel-item">
              <img
                src="{{ asset('img/bg_slide/SLIDE_02.jpg')}}"
                class="d-block w-100 img-carousel"
                alt="imagen-fondo-carousel"
              />
              <div class="carousel-caption d-none d-md-block">
                <h5>Guarda tus favoritas!</h5>
                <p>
                  Muestra amor a tus series favoritas guardándolas en tu perfil.
                </p>
              </div>
            </div>
            <div class="carousel-item">
              <img
                src="{{ asset('img/bg_slide/SLIDE_03.jpg')}}"
                class="d-block w-100 img-carousel"
                alt="imagen-fondo-carousel"
              />
              <div class="carousel-caption d-none d-md-block">
                <h5>Encuentra nuevas series!</h5>
                <p>
                  Encuentra los últimos lanzamientos, las series favoritas de la audiencia o busca según tus filtros.
                </p>
              </div>
            </div>
            <div class="carousel-item">
              <img
                src="{{ asset('img/bg_slide/SLIDE_04.jpg')}}"
                class="d-block w-100 img-carousel"
                alt="imagen-fondo-carousel"
              />
              <div class="carousel-caption d-none d-md-block">
                <h5>Valora las series!</h5>
                <p>
                  Observa las valoraciones de las series y añade la tuya según tus gustos.
                </p>
              </div>
            </div>
          </div>
          <button
            class="carousel-control-prev"
            type="button"
            data-bs-target="#carouselExampleCaptions"
            data-bs-slide="prev"
          >
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button
            class="carousel-control-next"
            type="button"
            data-bs-target="#carouselExampleCaptions"
            data-bs-slide="next"
          >
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>

        <div class="text-center contenedor-titulo">
          <div class="row row-cols-12">
            <div class="col">¿Qué puedo hacer?</div>
          </div>
        </div>

        <div class="flex-container container-paneles">
          <div class="panel-info">
            <p class="texto-info">
              Realiza un seguimiento de tus series favoritas usando las
              distintas listas!
            </p>
            <i class="bi bi-collection icono-info"></i>
          </div>
          <div class="panel-info">
            <p class="texto-info">
              Actualiza el contador de capítulos y temporadas para recordar dónde te quedaste!
            </p>
            <i class="bi bi-journal-bookmark icono-info"></i>
          </div>
          <div class="panel-info">
            <p class="texto-info">
              Obtén toda la información de cada serie!
            </p>
            <i class="bi bi-card-text icono-info"></i>
          </div>
          <div class="panel-info">
            <p class="texto-info">Elige tus series favoritas y guárdalas!</p>
            <i class="bi bi-heart icono-info"></i>
          </div>
          <div class="panel-info">
            <p class="texto-info">
              Descubre nuevas series y filtra por plataforma o género!
            </p>
            <i class="bi bi-search icono-info"></i>
          </div>
          <div class="panel-info">
            <p class="texto-info">
              Valora las distintas series según tus gustos!
            </p>
            <i class="bi bi-star icono-info"></i>
          </div>
        </div>

        <div class="text-center contenedor-titulo">
          <div class="row row-cols-12">
            <div class="col">Series Destacadas</div>
          </div>
        </div>

        <div class="flex-container index destacados-container">
          <div>
            <a href="{{ path('mostrar_serie_id_invitado', {'id': 1}) }}">
              <img
                src="{{ asset('img/posters/BB_POSTER.jpg')}}"
                class="card-img-top"
                alt="Poster Serie"
              />
            </a>
          </div>
          <div>
            <a href="{{ path('mostrar_serie_id_invitado', {'id': 9}) }}">
              <img
                src="{{ asset('img/posters/SOPRANO_POSTER.jpg')}}"
                class="card-img-top"
                alt="Poster Serie"
              />
            </a>
          </div>
          <div>
            <a href="{{ path('mostrar_serie_id_invitado', {'id': 3}) }}">
              <img
                src="{{ asset('img/posters/GOT_POSTER.jpg')}}"
                class="card-img-top"
                alt="Poster Serie"
              />
            </a>
          </div>
          <div>
            <a href="{{ path('mostrar_serie_id_invitado', {'id': 16}) }}">
              <img
                src="{{ asset('img/posters/LOST_POSTER.jpg')}}"
                class="card-img-top"
                alt="Poster Serie"
              />
            </a>
          </div>
          <div>
            <a href="{{ path('mostrar_serie_id_invitado', {'id': 15}) }}">
              <img
                src="{{ asset('img/posters/SUCCESSION_POSTER.jpg')}}"
                class="card-img-top"
                alt="Poster Serie"
              />
            </a>
          </div>
          <div>
            <a href="{{ path('mostrar_serie_id_invitado', {'id': 6}) }}">
              <img
                src="{{ asset('img/posters/SHOGUN_POSTER.jpg') }}"
                class="card-img-top"
                alt="Poster Serie"
              />
            </a>
          </div>
        </div>
    </section>

    <!-- Pie de pagina (footer) -->
