{% extends 'base.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3&display=swap" rel="stylesheet">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/form_login.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/landing.css') }}">
</style>
{% endblock %}

{% block title %}Iniciar Sesión{% endblock %}

{% block body %}
    <!-- NAVBAR: -->
    <nav class="navbar navbar-expand-lg d-flex">
      <div class="container-fluid">
        <!-- ICONO: -->
        <a class="navbar-brand" href="{{ path('index_') }}">
          <img src="{{ asset('img/icons/SerieSphere.gif') }}" alt="Serie Sphere" title="SerieSphere" class="logo-pagina">
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
          id="button-collapse"
          onclick="hidePfp();"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="{{ path('index_') }}">Inicio</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('destacados_invitado') }}"
                >Destacados</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('busqueda_invitado') }}"
                >Buscar</a
              >
            </li>
          </ul>
        </div>
        <a href="{{ path("index_") }}" class="btn btn-cerrar" id="btn-cerrar">
          Volver&nbsp;&nbsp;<i class="bi bi-arrow-return-left"></i>
        </a>
      </div>
    </nav>
    <div class="contenedor-flex col" id="contenedor-flex">
      <div class="contenedor" id="contenedor">
        <div class="contenedor-form login">
        {{ form_start(registrationForm) }}
            <h1>Registrarse</h1>
            {{ form_row(registrationForm.email, {'attr': {'placeholder': 'Email', label: false}}) }}
            {{ form_row(registrationForm.username, {'attr': {'placeholder': 'Nombre de Usuario'}}) }}
            {{ form_row(registrationForm.plainPassword, {'attr': {'placeholder': 'Contraseña'}}) }}
            Términos y Condiciones{{ form_row(registrationForm.agreeTerms) }}
            <button type="submit" class="btn toHome">Registrarse</button>
        {{ form_end(registrationForm) }}

        </div>
        <div class="contenedor-toggle">
          <div class="toggle">
            <div class="panel-toggle toggle-izq">
              <h1>Bienvenido!</h1>
              <p>¿Ya tienes cuenta? Inicia sesión!</p>
              <button class="toHome" id="login">Iniciar Sesión</button>
            </div>
            <div class="panel-toggle toggle-dcha">
              <h1>Bienvenido!</h1>
              <p>¿Ya tienes cuenta? Inicia sesión!</p>
              <a class="toHome" href="{{ path('app_login') }}" id="login">Iniciar Sesión</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div style="height: 10vh;"></div>

    <!-- Pie de pagina (footer) -->
    <footer>
      <div class="footer-container">
        <div class="footer-nav">
          <ul>
            <li class="footer-decor">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="5"
                viewBox="0 0 80 6"
                fill="none"
              >
                <path
                  d="M0 3H80"
                  stroke="url(#paint0_linear_44_98)"
                  stroke-opacity="0.8"
                  stroke-width="500"
                />
                <defs>
                  <linearGradient
                    id="paint0_linear_44_98"
                    x1="41.0833"
                    y1="3.00193"
                    x2="37.9583"
                    y2="3.00193"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0.168213" stop-color="#71DF7C" />
                    <stop offset="0.858244" stop-color="white" />
                  </linearGradient>
                </defs>
              </svg>
            </li>
            <li><a href="">Sobre Nosotros</a></li>
            <li><a href="">Ayuda</a></li>
            <li><a href="">API</a></li>
            <li><a href="">Términos</a></li>
            <li><a href="">Contacto</a></li>
            <li><a href="{{ path('declaracion_accesibilidad_invitado') }}"><i class="bi bi-universal-access-circle"></i></i></a></li>
            <li><a href="{{ path('mapa_web_invitado') }}"><i class="bi bi-globe"></i></a></li>
            <li><a>━━</a></li>
            <li>
              <a href=""><i class="social bi bi-twitter-x"></i></a>
            </li>
            <li>
              <a href=""><i class="social bi bi-instagram"></i></a>
            </li>
            <li>
              <a href=""><i class="social bi bi-youtube"></i></a>
            </li>
            <li class="footer-decor">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="5"
                viewBox="0 0 80 6"
                fill="none"
              >
                <path
                  d="M0 3H80"
                  stroke="url(#paint0_linear_44_98)"
                  stroke-opacity="0.8"
                  stroke-width="500"
                />
                <defs>
                  <linearGradient
                    id="paint0_linear_44_98"
                    x1="41.0833"
                    y1="3.00193"
                    x2="37.9583"
                    y2="3.00193"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0.168213" stop-color="#71DF7C" />
                    <stop offset="0.858244" stop-color="white" />
                  </linearGradient>
                </defs>
              </svg>
            </li>
          </ul>
        </div>
      </div>
    </footer>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="{{ asset('app.js') }}"></script>
{% endblock %}